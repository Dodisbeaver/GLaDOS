# GLaDOS Containerized Configuration
# Copy this file to .env and customize as needed

# === Container Runtime ===
GLADOS_RUNTIME=cpu              # Options: cpu, cuda
TTS_PORT=5050                   # Port for TTS API service
PROXY_PORT=3000                 # Port for audio proxy web interface

# === Ollama Configuration ===
# For Docker Desktop (Windows/macOS):
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# For Linux with host network:
# OLLAMA_BASE_URL=http://localhost:11434

# For external Ollama server:
# OLLAMA_BASE_URL=http://your-ollama-server:11434

OLLAMA_BASE_URL=http://host.docker.internal:11434

# === Audio Configuration ===
GLADOS_AUDIO_IO=webrtc          # Use WebRTC for containerized audio
GLADOS_WEBSOCKET_HOST=0.0.0.0   # WebSocket bind address
GLADOS_WEBSOCKET_PORT=8765      # WebSocket port for GLaDOS

# === Optional: Custom Model Configuration ===
# GLADOS_MODEL=llama3.2
# GLADOS_VOICE=glados
# GLADOS_VAD_THRESHOLD=0.8