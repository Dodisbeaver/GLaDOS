# GLaDOS Containerized Configuration
# Copy this file to .env and customize as needed

# === Container Runtime ===
GLADOS_RUNTIME=cpu              # Options: cpu, cuda
TTS_PORT=5050                   # Port for TTS API service
PROXY_PORT=6080                 # Port for audio proxy web interface
PROXY_HTTPS_PORT=6443           # Port for audio proxy HTTPS interface

# === Ollama Configuration ===
# For Docker Desktop (Windows/macOS):
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# For Linux with host network:
# OLLAMA_BASE_URL=http://localhost:11434

# For external Ollama server:
# OLLAMA_BASE_URL=http://your-ollama-server:11434

OLLAMA_BASE_URL=http://host.docker.internal:11434

# === Audio Configuration ===
GLADOS_AUDIO_IO=webrtc          # Use WebRTC for containerized audio
GLADOS_WEBSOCKET_HOST=0.0.0.0   # WebSocket bind address
GLADOS_WEBSOCKET_PORT=8765      # WebSocket port for GLaDOS

# === SSL Configuration ===
# SSL certificate details for audio proxy HTTPS
SSL_COUNTRY=US                   # Certificate country
SSL_STATE=California             # Certificate state/province
SSL_CITY=San Francisco           # Certificate city
SSL_ORG=GLaDOS                   # Certificate organization
SSL_OU=Audio Proxy               # Certificate organizational unit
SSL_CN=audio-proxy               # Certificate common name
SSL_EMAIL=admin@localhost        # Certificate email
SSL_LAN_IP=192.168.1.100         # Your server's LAN IP address
# SSL_EXTERNAL_IP=203.0.113.10   # External/public IP (optional)
# SSL_DOMAINS=mydomain.com        # Custom domains (optional, comma-separated)
SSL_DAYS=365                     # Certificate validity period in days

# === Optional: Custom Model Configuration ===
# GLADOS_MODEL=llama3.2
# GLADOS_VOICE=glados
# GLADOS_VAD_THRESHOLD=0.8