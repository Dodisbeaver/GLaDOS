# GLaDOS Assistant Container - Corrected Version
# Declare build argument at the top
ARG RUNTIME=cpu

FROM python:3.12-slim AS base

# Install system dependencies (including PortAudio for sounddevice import)
RUN apt-get update && apt-get install -y \
    git \
    curl \
    libportaudio2 \
    portaudio19-dev \
    espeak-ng \
    su-exec \
    && rm -rf /var/lib/apt/lists/*

# Install uv for dependency management
RUN pip install uv

WORKDIR /app

# Copy dependency files first for better layer caching
COPY pyproject.toml README.md ./

# Create non-root user early for package installation
FROM base AS base-with-user
RUN useradd -m -u 1000 glados && \
    chown -R glados:glados /app

USER glados

# Build stage for CPU variant
FROM base-with-user AS cpu-variant
RUN uv sync --extra cpu --no-dev

# Build stage for GPU variant
FROM base-with-user AS gpu-variant
RUN uv sync --extra cuda --no-dev

# Copy source code AFTER dependency installation (better caching)
FROM ${RUNTIME}-variant AS with-source
COPY --chown=glados:glados src/ ./src/
COPY --chown=glados:glados configs/ ./configs/
COPY --chown=glados:glados data/ ./data/
COPY --chown=glados:glados models/ ./src_models/

# Final stage - use build arg to select variant
FROM with-source AS final

# Create directories
RUN mkdir -p /app/models /app/data
VOLUME ["/app/models"]

# Copy entrypoint script
COPY --chown=glados:glados docker/glados-entrypoint.sh /entrypoint.sh

# Environment variables
ENV GLADOS_CONFIG_PATH=/app/configs/glados_config.yaml
ENV GLADOS_MODELS_PATH=/app/models
ENV GLADOS_AUDIO_IO=webrtc

ENTRYPOINT ["/entrypoint.sh"]
CMD ["uv", "run", "glados", "start"]